{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./modulo-01",
    "rewriteRelativeImportExtensions": true,
    "module": "nodenext",
    "target": "esnext", // Com essa configuração, a compilação do typescript utiliza a mais moderno
    "types": [],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
